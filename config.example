# keep-awake-agents config
# Sourced by the daemon on startup. After editing, restart:
#   launchctl kickstart -k gui/$(id -u)/com.keepawake.agents

# How often (seconds) to check for running agents. Default: 15.
POLL_INTERVAL=15

# Extra pgrep -f patterns. The daemon will also keep the Mac awake while
# any process matching one of these is running. ERE syntax, one per line.
# Examples:
#   "long-render-job"
#   "/usr/local/bin/my-trainer"
#   "ffmpeg .*-i .*\.mov"
EXTRA_PATTERNS=()

# Set to 1 to also prevent the display from sleeping (caffeinate -d).
# Default 0 = screen still sleeps / lid still dims, but the system stays awake.
PREVENT_DISPLAY_SLEEP=0

# ── Mode ──────────────────────────────────────────────────────────────────────
# A convenience that bundles the flags below. Set it from the menu bar (or
# `keep-awake-ctl.sh set-mode desk|cafe|lockedin`). The daemon is flag-driven —
# this line is just a label.
#   desk     — plugged in: stay awake while working, sleep when idle (default)
#   cafe     — lid closed on battery + hotspot kept alive (needs setup-lid-closed)
#   lockedin — never sleep while an agent is running
MODE=desk

# ── Activity detection ────────────────────────────────────────────────────────
# Keep the Mac awake while agents are *working*, and let it sleep once they're
# genuinely idle. "Working" = the agent process subtree burned CPU-time since the
# last poll, OR a fresh heartbeat exists (see keep-awake-heartbeat.sh). Far more
# reliable than CPU% — Claude/Codex sit near 0% CPU while waiting on the model,
# which is exactly when you do NOT want to sleep.
#
# AGENT_IDLE_MINUTES — sleep after this many minutes with no activity. 0 = never
#   idle-sleep while an agent is running. Default 5.
AGENT_IDLE_MINUTES=5
# A heartbeat newer than this many seconds counts as "working" (covers long,
# zero-CPU waits on the model API).
HEARTBEAT_WINDOW_SECS=180
# The agent subtree must gain more than this many CPU-seconds per poll to count
# as active. 1 ignores idle jitter.
CPU_DELTA_EPSILON_SECS=1

# ── Network keepalive ────────────────────────────────────────────────────────
# When NETWORK_KEEPALIVE=1, a background ping runs every NETWORK_KEEPALIVE_INTERVAL
# seconds while the wakelock is active.
#
# Why: cellular hotspots (iPhone/Android) and some Wi-Fi routers auto-disconnect
# clients that send no traffic. With the lid closed on AC power the Mac stays
# awake (caffeinate -s) but sends no packets, so the hotspot drops it within
# ~20–30 s. The ping keeps both sides alive.
#
# NETWORK_KEEPALIVE_HOST  — anything reachable on your current network works.
#   8.8.8.8 (Google DNS) is a safe default. Use your router's LAN IP if you
#   want to avoid going to the internet.
# NETWORK_KEEPALIVE_INTERVAL — 30 s is well below any hotspot idle timeout.
NETWORK_KEEPALIVE=0
NETWORK_KEEPALIVE_HOST=8.8.8.8
NETWORK_KEEPALIVE_INTERVAL=30

# ── Keep awake with the lid closed (incl. on battery) ────────────────────────
# macOS forces sleep when you close the lid on battery, which kills running
# agents. Set BATTERY_LID_CLOSED=1 to override that: while agents are active the
# daemon runs `pmset disablesleep 1` (the kernel lid-close override) so the Mac
# keeps running with the lid shut — on battery or AC. Released automatically
# when agents go idle, when paused, below the battery floor, and on exit.
#
# REQUIRES one-time sudo setup so the daemon can toggle it without a password:
#   keep-awake-ctl.sh setup-lid-closed      (or the menu-bar "Turn on…" item)
#
# ⚠️  Lid closed on battery = no airflow + silent drain. The Mac can get hot in
#     a bag. Meant for active runs you'll return to, not long-term storage.
BATTERY_LID_CLOSED=0

# BATTERY_FLOOR_PCT — safety floor. On battery, once charge hits this % the
# override is released so the Mac can sleep instead of draining to empty.
# Default 15. Set 0 to disable the floor (not recommended on battery).
BATTERY_FLOOR_PCT=15

# LID_CLOSED_MAX_HOURS — backstop. On battery, release the override after this
# many hours of continuous hold even if agents are still busy, so a jammed
# daemon can't keep the Mac awake indefinitely. Re-arms when agents go idle or
# you plug in. Default 8. Set 0 for no cap.
LID_CLOSED_MAX_HOURS=8
